generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  GUEST
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum AdminModule {
  DASHBOARD
  PRODUCTS
  ORDERS
  CUSTOMERS
  CATEGORIES
  BANNERS
  COUPONS
  FINANCE
  REPORTS
  SETTINGS
  EMPLOYEES
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
  MANAGE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
  REFUNDED
  RETURNED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
}

enum OrderAccessTokenType {
  GUEST
  EMAIL_LINK
}

/**
 * Tipos de movimentação manual de estoque.
 */
enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  ORDER_RESERVATION
  ORDER_RESTORE
}

/**
 * =========================================================
 * USUÁRIOS
 * =========================================================
 */

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String?
  phone    String?
  cpf      String?
  role     UserRole @default(USER)

  accountStatus     AccountStatus @default(GUEST)
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  disabledAt        DateTime?

  addresses Address[]
  orders    Order[]
  cartItems CartItem[]

  customerSessions        CustomerSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  adminProfile         AdminProfile?  @relation("AdminProfileUser")
  createdAdminProfiles AdminProfile[] @relation("AdminProfileCreatedBy")

  adminPermissions         AdminPermission[]
  adminSessions            AdminSession[]
  adminAuditLogs           AdminAuditLog[]
  adminTwoFactorChallenges AdminTwoFactorChallenge[]

  productStockMovements ProductStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountStatus])
  @@index([emailVerifiedAt])
  @@index([role])
}

model CustomerSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  email     String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, usedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, usedAt])
  @@index([expiresAt])
}

model LoginRateLimit {
  keyHash         String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  expiresAt       DateTime
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
  @@index([blockedUntil])
}

/**
 * =========================================================
 * ADMIN / FUNCIONÁRIOS
 * =========================================================
 */

model AdminProfile {
  id     String @id @default(cuid())
  userId String @unique

  jobTitle String

  active       Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  /**
   * Funcionário removido do painel.
   * Não apagamos fisicamente porque precisamos
   * preservar o histórico de auditoria.
   */
  removedAt DateTime?

  createdById String?

  user      User  @relation("AdminProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AdminProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([isSuperAdmin])
  @@index([removedAt])
  @@index([createdById])
}

model AdminPermission {
  id     String @id @default(cuid())
  userId String

  module AdminModule
  level  PermissionLevel @default(NONE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
  @@index([level])
}

model AdminSession {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

/**
 * =========================================================
 * SEGUNDO FATOR DO ADMINISTRADOR
 * =========================================================
 */

model AdminTwoFactorChallenge {
  id     String @id @default(cuid())
  userId String

  tokenHash String @unique
  codeHash  String

  attempts Int @default(0)

  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, usedAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model AdminAuditLog {
  id String @id @default(cuid())

  actorId String?

  module AdminModule
  action String

  entityType String
  entityId   String?

  changes Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/**
 * =========================================================
 * CATEGORIAS
 * =========================================================
 */

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  description String?
  image       String?

  active     Boolean   @default(true)
  sortOrder  Int       @default(0)
  archivedAt DateTime?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([archivedAt])
  @@index([sortOrder])
}

/**
 * =========================================================
 * PRODUTOS
 * =========================================================
 */

model Product {
  id String @id @default(cuid())

  name String
  slug String  @unique
  sku  String? @unique

  shortDescription String?
  description      String

  price     Decimal  @db.Decimal(10, 2)
  salePrice Decimal? @db.Decimal(10, 2)
  cost      Decimal? @db.Decimal(10, 2)

  /**
   * Mantido por compatibilidade com a loja atual.
   */
  image String

  /**
   * Mantido por compatibilidade.
   */
  religion String

  /**
   * Um produto pode pertencer a uma ou mais religiões.
   */
  religions String[] @default([])

  category String

  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  stock        Int
  minimumStock Int @default(0)

  /**
   * Peso em KG.
   * Dimensões em CM.
   */
  weight Decimal? @db.Decimal(10, 3)
  height Decimal? @db.Decimal(10, 2)
  width  Decimal? @db.Decimal(10, 2)
  length Decimal? @db.Decimal(10, 2)

  featured Boolean @default(false)
  active   Boolean @default(true)

  /**
   * Produto não é apagado fisicamente.
   */
  archivedAt DateTime?

  seoTitle       String?
  seoDescription String?

  images         ProductImage[]
  stockMovements ProductStockMovement[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([category])
  @@index([religion])
  @@index([active])
  @@index([featured])
  @@index([archivedAt])
  @@index([stock])
  @@index([createdAt])
}

/**
 * =========================================================
 * IMAGENS DOS PRODUTOS
 * =========================================================
 */

model ProductImage {
  id        String @id @default(cuid())
  productId String

  url      String
  publicId String? @unique
  alt      String?

  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, position])
  @@index([productId])
  @@index([productId, isPrimary])
}

/**
 * =========================================================
 * MOVIMENTAÇÕES DE ESTOQUE
 * =========================================================
 * Histórico permanente das alterações manuais de estoque.
 * ENTRY:
 * entrada de mercadoria.
 * EXIT:
 * saída manual.
 * ADJUSTMENT:
 * correção do estoque após inventário/conferência.
 */

model ProductStockMovement {
  id String @id @default(cuid())

  productId String

  /**
   * Funcionário responsável em movimentações manuais.
   * Movimentações automáticas do checkout não possuem actorId.
   */
  actorId String?

  /**
   * Pedido responsável pela reserva ou reposição.
   * Movimentações manuais não possuem orderId.
   */
  orderId String?

  type StockMovementType

  quantity Int

  previousStock Int
  newStock      Int

  reason String
  note   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  /**
   * Um pedido só pode reservar ou devolver o estoque
   * de cada produto uma única vez.
   * Como PostgreSQL permite vários NULL em unique,
   * isso não interfere nas movimentações manuais.
   */
  @@unique([orderId, productId, type])
  @@index([productId])
  @@index([actorId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([orderId, createdAt])
}

/**
 * =========================================================
 * CARRINHO
 * =========================================================
 */

model CartItem {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

/**
 * =========================================================
 * ENDEREÇOS
 * =========================================================
 */

model Address {
  id           String    @id @default(cuid())
  userId       String
  name         String
  cep          String
  state        String
  city         String
  neighborhood String
  street       String
  number       String
  complement   String?
  isDefault    Boolean   @default(false)
  archivedAt   DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, archivedAt])
  @@index([userId, isDefault])
}

/**
 * =========================================================
 * PEDIDOS
 * =========================================================
 */

model Order {
  id        String      @id @default(cuid())
  userId    String
  addressId String?
  status    OrderStatus @default(PENDING)

  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  expiresAt DateTime?

  trackingCode String?
  trackingUrl  String?
  carrier      String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id])

  items          OrderItem[]
  payment        Payment?
  history        OrderStatusHistory[]
  accessTokens   OrderAccessToken[]
  stockMovements ProductStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/**
 * =========================================================
 * ITENS DO PEDIDO
 * =========================================================
 */

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  /**
   * Snapshot do produto.
   */
  name     String
  image    String
  price    Decimal @db.Decimal(10, 2)
  quantity Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

/**
 * =========================================================
 * PAGAMENTOS
 * =========================================================
 */

model Payment {
  id       String        @id @default(cuid())
  orderId  String        @unique
  provider String        @default("mercadopago")
  status   PaymentStatus @default(PENDING)

  mercadoPagoPaymentId    String?
  mercadoPagoPreferenceId String?
  paymentMethod           String?
  paymentUrl              String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([mercadoPagoPaymentId])
  @@index([mercadoPagoPreferenceId])
}

/**
 * =========================================================
 * HISTÓRICO DOS PEDIDOS
 * =========================================================
 */

model OrderStatusHistory {
  id      String      @id @default(cuid())
  orderId String
  status  OrderStatus
  title   String
  message String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

/**
 * =========================================================
 * ACESSO DO VISITANTE AO PEDIDO
 * =========================================================
 */

model OrderAccessToken {
  id        String               @id @default(cuid())
  orderId   String
  tokenHash String               @unique
  type      OrderAccessTokenType @default(GUEST)

  expiresAt DateTime
  revokedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([orderId, type])
  @@index([expiresAt])
  @@index([revokedAt])
}
